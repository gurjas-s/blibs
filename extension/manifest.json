{
  "manifest_version": 3,
  "name": "blibs companion — personal-agent inbox sync (POC)",
  "version": "0.1.0",
  "description": "Reads YOUR logged-in chats on muse.ai, chatgpt.com and grok.com (with your permission) and pushes them to your local blibs panel. Nothing leaves your machine except POSTs to localhost.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://muse.ai/*",
    "https://chatgpt.com/*",
    "https://grok.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://muse.ai/*", "https://chatgpt.com/*", "https://grok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "blibs sync"
  }
}
