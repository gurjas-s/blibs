# Copy to .env (proxy reads these). Frontend keys live in localStorage instead.
META_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Optional custom OpenAI-compatible endpoint for "Custom" agents
CUSTOM_API_URL=https://api.openai.com/v1/chat/completions
PROXY_PORT=8787

# Relay loop (Muse -> local harness -> Muse). BLIBS_RELAY=1 turns it on.
# BLIBS_HARNESS_CMD is a command line without a shell, or a JSON string array.
# BLIBS_HARNESS_CWD must be a scratch directory, not this checkout.
BLIBS_RELAY=
BLIBS_RELAY_PROVIDER=
BLIBS_HARNESS_CMD=
BLIBS_HARNESS_CWD=
BLIBS_RELAY_TIMEOUT_MS=
