# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
node_modules
dist
dist-ssr
build
*.local

# E2E screenshots and traces
tests/e2e/artifacts/

# Env (keys!) — .env.example stays tracked, real .env never does
.env
.env.*.local

# Evidence reports and reproduction notes. Screenshots stay tracked so merged
# pull request images still render.
evidence/**/*.md

# blibs runtime data: your real synced chats + queued sends live here.
# The proxy recreates these files on demand — never commit them.
server/imports.json
server/outbox.json
*.sqlite*
server/imports.pre-sqlite.json
.local-models/

# Packaged app output
out
dist-electron

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
