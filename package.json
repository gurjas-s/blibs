{
  "name": "blibs",
  "private": true,
  "version": "0.1.0",
  "description": "blibs desktop app: one panel for your personal agents, with persistent vendor sessions built in",
  "type": "module",
  "main": "build/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b --force && node scripts/emit-cjs-markers.mjs && vite build",
    "clean": "node scripts/clean.mjs",
    "e2e": "npm run build && node --import tsx --test tests/e2e/smoke.spec.ts",
    "postinstall": "node scripts/check-electron.mjs",
    "prestart": "node scripts/check-electron.mjs",
    "start": "electron .",
    "smoke": "electron . --blibs-smoke",
    "test": "npm run build && node --import tsx --test tests/*.test.ts && tsx src/main/test-harness.ts",
    "verify:clean-build": "node scripts/verify-clean-build.mjs",
    "lint": "eslint . --max-warnings=0",
    "test:desktop": "node scripts/test-search-desktop.mjs",
    "icons": "node assets/build-icons.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^34.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.28.2": true
  }
}
