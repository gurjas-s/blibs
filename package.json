{
  "name": "blibs",
  "private": true,
  "version": "0.1.0",
  "description": "blibs desktop app: one panel for your personal agents, with persistent vendor sessions built in",
  "type": "module",
  "main": "build/main/index.js",
  "scripts": {
    "build": "tsc -b --force && node scripts/emit-cjs-markers.mjs && vite build",
    "clean": "node scripts/clean.mjs",
    "start": "electron .",
    "smoke": "electron . --blibs-smoke",
    "test": "npm run build && node --import tsx --test tests/*.test.ts && tsx src/main/test-harness.ts",
    "verify:clean-build": "node scripts/verify-clean-build.mjs",
    "lint": "oxlint",
    "test:desktop": "node scripts/test-search-desktop.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^34.0.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.28.2": true
  }
}
